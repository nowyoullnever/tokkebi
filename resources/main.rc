#include "../src/app/resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Embedded into the Standalone executable and, via CMake, the VST3 module.
// IGraphicsWin locates every bundled UI font by the exact filename and TTF type.
TOKKEBI_PRIMARY_FONT TTF "../assets/fonts/dunggeunmo/dunggeunmo.ttf"
TOKKEBI_BODY_FONT TTF "../assets/fonts/ridibatang/ridibatang.otf"
TOKKEBI_TECHNICAL_FONT TTF "../assets/fonts/galmuri/galmuri11-bitmap-regular-2.40.4.ttf"

IDD_DIALOG_MAIN DIALOG 0, 0, 580, 380
STYLE WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "tokkebi"
BEGIN
END

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0, 1, 0, 0
 PRODUCTVERSION 0, 1, 0, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "FileDescription", "tokkebi"
      VALUE "InternalName", "tokkebi"
      VALUE "ProductName", "tokkebi"
      VALUE "CompanyName", "nowyoullnever"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
